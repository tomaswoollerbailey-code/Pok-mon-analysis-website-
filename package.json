{
  "name": "pokemon-meta-analysis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pok\u00e9mon TCG meta analysis for online and offline tournaments, built from Limitless data.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "fetch:online": "tsx scripts/fetch-online.ts",
    "fetch:offline": "tsx scripts/fetch-offline.ts",
    "fetch:prices": "tsx scripts/fetch-prices.ts",
    "build:data": "tsx scripts/build-dataset.ts",
    "data": "npm run fetch:online && npm run fetch:offline && npm run fetch:prices && npm run build:data",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cheerio": "^1.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
